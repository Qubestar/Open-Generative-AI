{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vidmyo.local/schemas/repurpose/reframe-artifact.v1.schema.json",
  "title": "Vidmyo Repurpose reframe artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_version", "engine_version", "created_at", "versions", "source", "settings", "cache_key", "requested_candidate_ids", "candidates"],
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidateId": {"type": "string", "pattern": "^clip_[0-9]{3,}$"},
    "face": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "y", "width", "height", "confidence"],
      "properties": {
        "x": {"type": "number", "minimum": 0}, "y": {"type": "number", "minimum": 0},
        "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["requested", "state", "path", "fingerprint", "duration_seconds", "width", "height"],
      "properties": {
        "requested": {"type": "boolean"},
        "state": {"enum": ["not_requested", "pending", "completed"]},
        "path": {"type": ["string", "null"]},
        "fingerprint": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "duration_seconds": {"type": ["number", "null"], "minimum": 0},
        "width": {"type": ["integer", "null"], "minimum": 1},
        "height": {"type": ["integer", "null"], "minimum": 1}
      }
    }
  },
  "properties": {
    "artifact_version": {"const": 1},
    "engine_version": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "versions": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "detector", "tracker", "renderer"],
      "properties": {
        "schema": {"const": "reframe-artifact.v1"},
        "detector": {"const": "yunet-2023mar.v1"},
        "tracker": {"const": "single-speaker-tracker.v1"},
        "renderer": {"const": "vertical-preview.v1"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["fingerprint", "boundary_cache_key"],
      "properties": {"fingerprint": {"$ref": "#/$defs/hash"}, "boundary_cache_key": {"$ref": "#/$defs/hash"}}
    },
    "settings": {
      "type": "object", "additionalProperties": false,
      "required": ["output_width", "output_height", "sample_interval_seconds", "confidence_threshold", "coverage_threshold", "safe_zone_margin", "safe_zone_target", "dead_zone_fraction", "smoothing_alpha", "maximum_step_fraction", "minimum_hold_seconds", "duration_tolerance_seconds"],
      "properties": {
        "output_width": {"const": 1080}, "output_height": {"const": 1920},
        "sample_interval_seconds": {"const": 0.5}, "confidence_threshold": {"const": 0.75},
        "coverage_threshold": {"const": 0.8}, "safe_zone_margin": {"const": 0.1},
        "safe_zone_target": {"const": 0.95}, "dead_zone_fraction": {"const": 0.05},
        "smoothing_alpha": {"const": 0.35}, "maximum_step_fraction": {"const": 0.08},
        "minimum_hold_seconds": {"const": 1.0},
        "duration_tolerance_seconds": {"type": "number", "minimum": 0.05}
      }
    },
    "cache_key": {"$ref": "#/$defs/hash"},
    "requested_candidate_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/candidateId"}},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["candidate_id", "input", "mode", "fallback_reason", "coverage", "mean_confidence", "safe_zone_fraction", "samples", "segments", "output_key", "output"],
        "properties": {
          "candidate_id": {"$ref": "#/$defs/candidateId"},
          "input": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "fingerprint", "duration_seconds", "width", "height"],
            "properties": {
              "path": {"type": "string", "minLength": 1}, "fingerprint": {"$ref": "#/$defs/hash"},
              "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
              "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}
            }
          },
          "mode": {"enum": ["track", "fallback"]},
          "fallback_reason": {"type": ["string", "null"], "enum": [null, "no_face", "multiple_faces", "low_confidence", "insufficient_face_coverage", "unsafe_crop"]},
          "coverage": {"type": "number", "minimum": 0, "maximum": 1},
          "mean_confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "safe_zone_fraction": {"type": "number", "minimum": 0, "maximum": 1},
          "samples": {
            "type": "array", "items": {
              "type": "object", "additionalProperties": false,
              "required": ["time_seconds", "faces", "crop_x", "crop_y"],
              "properties": {
                "time_seconds": {"type": "number", "minimum": 0},
                "faces": {"type": "array", "items": {"$ref": "#/$defs/face"}},
                "crop_x": {"type": ["integer", "null"], "minimum": 0},
                "crop_y": {"type": ["integer", "null"], "minimum": 0}
              }
            }
          },
          "segments": {
            "type": "array", "items": {
              "type": "object", "additionalProperties": false,
              "required": ["start_seconds", "end_seconds", "x", "y", "width", "height"],
              "properties": {
                "start_seconds": {"type": "number", "minimum": 0}, "end_seconds": {"type": "number", "minimum": 0},
                "x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0},
                "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}
              }
            }
          },
          "output_key": {"$ref": "#/$defs/hash"},
          "output": {"$ref": "#/$defs/output"}
        }
      }
    }
  }
}

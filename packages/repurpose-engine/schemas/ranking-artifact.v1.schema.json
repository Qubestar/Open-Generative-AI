{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vidmyo.local/schemas/repurpose/ranking-artifact.v1.schema.json",
  "title": "Vidmyo Repurpose ranking artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_version", "engine_version", "created_at", "versions", "source",
    "provider", "settings", "weights", "thresholds", "cache_key",
    "duplicate_groups", "shortlist_candidate_ids", "candidates"
  ],
  "$defs": {
    "wordId": { "type": "string", "pattern": "^word_[0-9]{6}$" },
    "candidateId": { "type": "string", "pattern": "^clip_[0-9]{3,}$" },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "span": {
      "type": "object", "additionalProperties": false,
      "required": ["first_word_id", "last_word_id", "start_seconds", "end_seconds", "text"],
      "properties": {
        "first_word_id": { "$ref": "#/$defs/wordId" },
        "last_word_id": { "$ref": "#/$defs/wordId" },
        "start_seconds": { "type": "number", "minimum": 0 },
        "end_seconds": { "type": "number", "minimum": 0 },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "provider_suggestion_id", "window_id", "title", "hook", "summary",
        "selection_reason", "signal_types", "proposed_span", "evidence_spans"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/candidateId" },
        "provider_suggestion_id": { "type": "string", "minLength": 1 },
        "window_id": { "type": "string", "pattern": "^window_[0-9]{6}$" },
        "title": { "type": "string", "minLength": 1 },
        "hook": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "selection_reason": { "type": "string", "minLength": 1 },
        "signal_types": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["story", "claim", "tip", "conflict", "revelation", "quote", "payoff"] }
        },
        "proposed_span": { "$ref": "#/$defs/span" },
        "evidence_spans": {
          "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/span" }
        }
      }
    },
    "semanticComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "reason", "evidence_word_ids"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "reason": { "type": "string", "minLength": 1 },
        "evidence_word_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/wordId" }
        }
      }
    },
    "deterministicComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "method"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "method": { "const": "deterministic" }
      }
    }
  },
  "properties": {
    "artifact_version": { "const": 1 },
    "engine_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "versions": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "prompt", "scoring", "dedupe"],
      "properties": {
        "schema": { "const": "ranking-artifact.v1" },
        "prompt": { "const": "ranking-prompt.v1" },
        "scoring": { "const": "transcript-scoring.v1" },
        "dedupe": { "const": "candidate-dedupe.v1" }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": [
        "fingerprint", "transcript_cache_key", "candidate_cache_key",
        "candidate_content_hash", "candidate_count"
      ],
      "properties": {
        "fingerprint": { "$ref": "#/$defs/hash" },
        "transcript_cache_key": { "$ref": "#/$defs/hash" },
        "candidate_cache_key": { "$ref": "#/$defs/hash" },
        "candidate_content_hash": { "$ref": "#/$defs/hash" },
        "candidate_count": { "type": "integer", "minimum": 1 }
      }
    },
    "provider": {
      "type": "object", "additionalProperties": false, "required": ["id", "model"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 }
      }
    },
    "settings": {
      "type": "object", "additionalProperties": false,
      "required": ["requested_clip_count", "temperature", "structured_output", "streaming"],
      "properties": {
        "requested_clip_count": { "type": "integer", "minimum": 1 },
        "temperature": { "const": 0.0 },
        "structured_output": { "const": true },
        "streaming": { "const": false }
      }
    },
    "weights": {
      "type": "object", "additionalProperties": false,
      "required": [
        "hook_strength", "standalone_coherence", "information_value_novelty",
        "narrative_arc_payoff", "context_independence", "duration_fitness", "evidence_quality"
      ],
      "properties": {
        "hook_strength": { "const": 0.2 },
        "standalone_coherence": { "const": 0.2 },
        "information_value_novelty": { "const": 0.15 },
        "narrative_arc_payoff": { "const": 0.15 },
        "context_independence": { "const": 0.15 },
        "duration_fitness": { "const": 0.1 },
        "evidence_quality": { "const": 0.05 }
      }
    },
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "required": [
        "hard_gate", "temporal_iou", "temporal_containment", "semantic_similarity",
        "repeated_topic_penalty", "nearby_time_penalty", "nearby_time_seconds"
      ],
      "properties": {
        "hard_gate": { "const": 40.0 },
        "temporal_iou": { "const": 0.7 },
        "temporal_containment": { "const": 0.85 },
        "semantic_similarity": { "const": 0.8 },
        "repeated_topic_penalty": { "const": 12.0 },
        "nearby_time_penalty": { "const": 8.0 },
        "nearby_time_seconds": { "type": "number", "minimum": 180 }
      }
    },
    "cache_key": { "$ref": "#/$defs/hash" },
    "duplicate_groups": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "leader_candidate_id", "member_candidate_ids"],
        "properties": {
          "id": { "type": "string", "pattern": "^duplicate_group_[0-9]{3}$" },
          "leader_candidate_id": { "$ref": "#/$defs/candidateId" },
          "member_candidate_ids": {
            "type": "array", "minItems": 2, "uniqueItems": true,
            "items": { "$ref": "#/$defs/candidateId" }
          }
        }
      }
    },
    "shortlist_candidate_ids": {
      "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/candidateId" }
    },
    "candidates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "candidate", "topic_label", "semantic_claim", "components", "clip_potential",
          "overall_rank", "hard_gate", "duplicate_group_id", "near_duplicate_of",
          "shortlist_exclusion_reasons", "diversity", "shortlist_order", "recommended"
        ],
        "properties": {
          "candidate": { "$ref": "#/$defs/candidate" },
          "topic_label": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "semantic_claim": { "type": "string", "minLength": 1 },
          "components": {
            "type": "object", "additionalProperties": false,
            "required": [
              "hook_strength", "standalone_coherence", "information_value_novelty",
              "narrative_arc_payoff", "context_independence", "duration_fitness", "evidence_quality"
            ],
            "properties": {
              "hook_strength": { "$ref": "#/$defs/semanticComponent" },
              "standalone_coherence": { "$ref": "#/$defs/semanticComponent" },
              "information_value_novelty": { "$ref": "#/$defs/semanticComponent" },
              "narrative_arc_payoff": { "$ref": "#/$defs/semanticComponent" },
              "context_independence": { "$ref": "#/$defs/semanticComponent" },
              "duration_fitness": { "$ref": "#/$defs/deterministicComponent" },
              "evidence_quality": { "$ref": "#/$defs/deterministicComponent" }
            }
          },
          "clip_potential": { "type": "number", "minimum": 0, "maximum": 100 },
          "overall_rank": { "type": "integer", "minimum": 1 },
          "hard_gate": {
            "type": "object", "additionalProperties": false,
            "required": ["passed", "exclusion_reasons"],
            "properties": {
              "passed": { "type": "boolean" },
              "exclusion_reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          },
          "shortlist_exclusion_reasons": {
            "type": "array", "items": { "type": "string", "minLength": 1 }
          },
          "duplicate_group_id": { "type": ["string", "null"], "pattern": "^duplicate_group_[0-9]{3}$" },
          "near_duplicate_of": { "oneOf": [{ "$ref": "#/$defs/candidateId" }, { "type": "null" }] },
          "diversity": {
            "type": "object", "additionalProperties": false,
            "required": ["adjusted_score", "repeated_topic_penalty", "nearby_time_penalty"],
            "properties": {
              "adjusted_score": { "type": ["number", "null"] },
              "repeated_topic_penalty": { "type": "number", "minimum": 0 },
              "nearby_time_penalty": { "type": "number", "minimum": 0 }
            }
          },
          "shortlist_order": { "type": ["integer", "null"], "minimum": 1 },
          "recommended": { "type": "boolean" }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vidmyo.local/schemas/repurpose/worker-request.v1.schema.json",
  "title": "Vidmyo Repurpose worker request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "job_id",
    "project_dir",
    "stage",
    "input_artifacts",
    "options"
  ],
  "properties": {
    "protocol_version": { "const": 1 },
    "job_id": { "type": "string", "pattern": "^job_[A-Za-z0-9_-]+$" },
    "project_dir": { "type": "string", "minLength": 1 },
    "stage": {
      "enum": [
        "ingest",
        "transcribe",
        "generate_candidates",
        "rank",
        "repair_boundaries",
        "reframe",
        "render"
      ]
    },
    "input_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "version": { "type": ["integer", "null"], "minimum": 1 }
        }
      }
    },
    "options": { "type": "object" }
  }
}
